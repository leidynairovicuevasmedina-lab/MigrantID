<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <Style
        TargetType="Page"
        ApplyToDerivedTypes="True">

        <Setter
            Property="BackgroundColor"
            Value="#F7F6FA" />

    </Style>


    <Style
        x:Key="HeaderLabel"
        TargetType="Label">

        <Setter
            Property="FontSize"
            Value="25" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="TextColor"
            Value="#352B54" />

        <Setter
            Property="Margin"
            Value="0,0,0,4" />

    </Style>


    <Style
        x:Key="SubheaderLabel"
        TargetType="Label">

        <Setter
            Property="FontSize"
            Value="14" />

        <Setter
            Property="TextColor"
            Value="#736F7D" />

        <Setter
            Property="Margin"
            Value="0,0,0,8" />

    </Style>

 
    <Style
        x:Key="FormLabel"
        TargetType="Label">

        <Setter
            Property="FontSize"
            Value="14" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="TextColor"
            Value="#432663" />

        <Setter
            Property="Margin"
            Value="0,5,0,2" />

    </Style>

  
    <Style TargetType="Entry">

        <Setter
            Property="TextColor"
            Value="#352B54" />

        <Setter
            Property="PlaceholderColor"
            Value="#898393" />

        <Setter
            Property="FontSize"
            Value="15" />

        <Setter
            Property="HeightRequest"
            Value="48" />

    </Style>


    <Style TargetType="Picker">

        <Setter
            Property="TextColor"
            Value="#352B54" />

        <Setter
            Property="TitleColor"
            Value="#898393" />

        <Setter
            Property="FontSize"
            Value="15" />

        <Setter
            Property="HeightRequest"
            Value="48" />

    </Style>


    <Style TargetType="Editor">

        <Setter
            Property="TextColor"
            Value="#352B54" />

        <Setter
            Property="PlaceholderColor"
            Value="#898393" />

        <Setter
            Property="FontSize"
            Value="15" />

    </Style>

   
    <Style
        x:Key="Card"
        TargetType="Border">

        <Setter
            Property="BackgroundColor"
            Value="#FFFFFF" />

        <Setter
            Property="Stroke"
            Value="#E5DDF0" />

        <Setter
            Property="StrokeThickness"
            Value="1" />

        <Setter
            Property="Padding"
            Value="18" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>

    </Style>

  
    <Style
        x:Key="PrimaryButton"
        TargetType="Button">

        <Setter
            Property="BackgroundColor"
            Value="#6742A3" />

        <Setter
            Property="TextColor"
            Value="White" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="FontSize"
            Value="15" />

        <Setter
            Property="CornerRadius"
            Value="12" />

        <Setter
            Property="HeightRequest"
            Value="50" />

        <Setter
            Property="Margin"
            Value="0,6,0,0" />

    </Style>


    <Style
        x:Key="SecondaryButton"
        TargetType="Button">

        <Setter
            Property="BackgroundColor"
            Value="#F0E9FC" />

        <Setter
            Property="TextColor"
            Value="#512478" />

        <Setter
            Property="BorderColor"
            Value="#CDBBE9" />

        <Setter
            Property="BorderWidth"
            Value="1" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="FontSize"
            Value="15" />

        <Setter
            Property="CornerRadius"
            Value="12" />

        <Setter
            Property="HeightRequest"
            Value="48" />

    </Style>


    <Style
        x:Key="DangerButton"
        TargetType="Button">

        <Setter
            Property="BackgroundColor"
            Value="#BE3030" />

        <Setter
            Property="TextColor"
            Value="White" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="CornerRadius"
            Value="12" />

        <Setter
            Property="HeightRequest"
            Value="48" />

    </Style>


    <Style
        x:Key="ErrorLabel"
        TargetType="Label">

        <Setter
            Property="TextColor"
            Value="#C62828" />

        <Setter
            Property="FontSize"
            Value="13" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="Margin"
            Value="0,2,0,4" />

    </Style>


    <Style
        x:Key="ListTitle"
        TargetType="Label">

        <Setter
            Property="FontSize"
            Value="24" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="TextColor"
            Value="#352B54" />

        <Setter
            Property="Margin"
            Value="0,0,0,6" />

    </Style>

  
    <Style
        x:Key="EmptyState"
        TargetType="Label">

        <Setter
            Property="TextColor"
            Value="#736F7D" />

        <Setter
            Property="FontSize"
            Value="14" />

        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />

        <Setter
            Property="Margin"
            Value="0,20" />

    </Style>

</ResourceDictionary>
