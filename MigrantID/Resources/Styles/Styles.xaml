<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- FONDO GENERAL DE LA APLICACIÓN -->

    <Style TargetType="Page"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="#F4F7FA" />
    </Style>

    <!-- TÍTULOS PRINCIPALES -->

    <Style x:Key="HeaderLabel"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="25" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="#173B57" />
        <Setter Property="Margin"
                Value="0,0,0,4" />
    </Style>

    <!-- DESCRIPCIÓN DE LA PÁGINA -->

    <Style x:Key="SubheaderLabel"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="TextColor"
                Value="#66788A" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
    </Style>

    <!-- ETIQUETAS DE LOS CAMPOS -->

    <Style x:Key="FormLabel"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="#26465F" />
        <Setter Property="Margin"
                Value="0,5,0,2" />
    </Style>

    <!-- TARJETAS DE FORMULARIOS -->

    <Style x:Key="Card"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="#FFFFFF" />
        <Setter Property="Stroke"
                Value="#DEE6ED" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="18" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle
                    CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BOTÓN PRINCIPAL -->

    <Style x:Key="PrimaryButton"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="#176B87" />
        <Setter Property="TextColor"
                Value="White" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="HeightRequest"
                Value="50" />
        <Setter Property="Margin"
                Value="0,6,0,0" />
    </Style>

    <!-- BOTÓN SECUNDARIO -->

    <Style x:Key="SecondaryButton"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="#FFFFFF" />
        <Setter Property="TextColor"
                Value="#176B87" />
        <Setter Property="BorderColor"
                Value="#176B87" />
        <Setter Property="BorderWidth"
                Value="1" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="HeightRequest"
                Value="48" />
    </Style>

    <!-- BOTÓN CERRAR SESIÓN -->

    <Style x:Key="DangerButton"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="#B84040" />
        <Setter Property="TextColor"
                Value="White" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="HeightRequest"
                Value="48" />
    </Style>

    <!-- MENSAJES DE VALIDACIÓN -->

    <Style x:Key="ErrorLabel"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="#B42318" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Margin"
                Value="0,2,0,4" />
    </Style>

    <!-- TÍTULOS DE LISTADOS -->

    <Style x:Key="ListTitle"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="24" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="#173B57" />
        <Setter Property="Margin"
                Value="0,0,0,6" />
    </Style>

    <!-- MENSAJES DE LISTAS VACÍAS -->

    <Style x:Key="EmptyState"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="#66788A" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="HorizontalTextAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,20" />
    </Style>

</ResourceDictionary>
