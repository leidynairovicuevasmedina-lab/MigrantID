<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.UsuariosPage"
    Title="Usuarios"
    BackgroundColor="#F4F7FA">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="14">

       
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="Usuarios registrados"
                Style="{StaticResource ListTitle}" />

            <Label
                Text="Consulta los usuarios registrados en MigrantID."
                Style="{StaticResource SubheaderLabel}" />

        </VerticalStackLayout>

      
        <CollectionView
            x:Name="UsuariosCollection"
            Grid.Row="1"
            SelectionMode="None">

           
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20,45"
                    Spacing="12"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="No hay usuarios registrados"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#173B57"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Agrega un usuario para comenzar."
                        Style="{StaticResource EmptyState}" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            
            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,12">

                        <VerticalStackLayout Spacing="10">

                          
                            <Label
                                Text="{Binding Nombre}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#173B57" />

                           
                            <Label
                                Text="Correo electrónico"
                                FontSize="12"
                                TextColor="#66788A" />

                            <Label
                                Text="{Binding Correo}"
                                FontSize="14"
                                TextColor="#26465F"
                                LineBreakMode="WordWrap" />

                           
                            <Label
                                Text="Rol asignado"
                                FontSize="12"
                                TextColor="#66788A" />

                            <Label
                                Text="{Binding Rol}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#176B87" />

                        
                            <BoxView
                                HeightRequest="1"
                                Color="#DEE6ED"
                                Margin="0,5" />

                            
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    Grid.Column="0"
                                    Text="EDITAR"
                                    Style="{StaticResource PrimaryButton}"
                                    HeightRequest="44"
                                    FontSize="13"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnEditarClicked" />

                                <Button
                                    Grid.Column="1"
                                    Text="ELIMINAR"
                                    BackgroundColor="#FFF1F1"
                                    TextColor="#B42318"
                                    BorderColor="#E8B8B8"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnEliminarClicked" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        
        <Button
            Grid.Row="2"
            Text="+ AGREGAR USUARIO"
            Style="{StaticResource PrimaryButton}"
            Clicked="OnAgregarClicked" />

    </Grid>

</ContentPage>
