<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.DocumentoFormPage"
    Title="Documento"
    BackgroundColor="#F4F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            
            <Label
                x:Name="TituloLabel"
                Text="Registrar documento"
                Style="{StaticResource HeaderLabel}" />

            <Label
                Text="Completa la información del documento."
                Style="{StaticResource SubheaderLabel}" />

            
            <Border Style="{StaticResource Card}">

                <VerticalStackLayout Spacing="12">

                    
                    <Label
                        Text="Tipo de documento"
                        Style="{StaticResource FormLabel}" />

                    <Picker
                        x:Name="TipoDocumentoPicker"
                        Title="Seleccione el tipo de documento">

                        <Picker.Items>
                            <x:String>Pasaporte</x:String>
                            <x:String>Documento de identidad (ID)</x:String>
                            <x:String>Residencia temporal</x:String>
                            <x:String>Residencia permanente</x:String>
                            <x:String>Permiso de permanencia</x:String>
                        </Picker.Items>
                    </Picker>

                    
                    <Label
                        Text="Número de documento"
                        Style="{StaticResource FormLabel}" />

                    <Entry
                        x:Name="NumeroDocumentoEntry"
                        Placeholder="Ingrese el número del documento" />

                    
                    <Label
                        Text="País de emisión"
                        Style="{StaticResource FormLabel}" />

                    <Picker
                        x:Name="PaisEmisionPicker"
                        Title="Seleccione el país">

                        <Picker.Items>
                            <x:String>República Dominicana</x:String>
                            <x:String>Haití</x:String>
                            <x:String>Venezuela</x:String>
                            <x:String>Colombia</x:String>
                            <x:String>Cuba</x:String>
                            <x:String>Estados Unidos</x:String>
                            <x:String>Canadá</x:String>
                            <x:String>México</x:String>
                            <x:String>España</x:String>
                            <x:String>Francia</x:String>
                            <x:String>Brasil</x:String>
                            <x:String>Argentina</x:String>
                            <x:String>Chile</x:String>
                            <x:String>Perú</x:String>
                            <x:String>China</x:String>
                            <x:String>India</x:String>
                            <x:String>Jamaica</x:String>
                        </Picker.Items>

                    </Picker>

                   
                    <Label
                        Text="Fecha de emisión"
                        Style="{StaticResource FormLabel}" />

                    <DatePicker
                        x:Name="FechaEmisionPicker" />

                    
                    <Label
                        Text="Fecha de vencimiento"
                        Style="{StaticResource FormLabel}" />

                    <DatePicker
                        x:Name="FechaVencimientoPicker" />

                    
                    <Label
                        Text="Estado"
                        Style="{StaticResource FormLabel}" />

                    <Picker
                        x:Name="EstadoPicker"
                        Title="Seleccione el estado">

                        <Picker.Items>
                            <x:String>Vigente</x:String>
                            <x:String>En revisión</x:String>
                            <x:String>Vencido</x:String>
                        </Picker.Items>

                    </Picker>

                    
                    <Label
                        x:Name="MensajeErrorLabel"
                        TextColor="Red"
                        IsVisible="False" />

                </VerticalStackLayout>

            </Border>

            
            <Button
                Text="GUARDAR"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnGuardarClicked" />

            <Button
                Text="CANCELAR"
                Style="{StaticResource SecondaryButton}"
                Clicked="OnCancelarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
