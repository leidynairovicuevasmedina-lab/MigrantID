<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.DocumentoFormPage"
    Title="Documento"
    BackgroundColor="#F7F4FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,20,20,28"
            Spacing="14">

            <!-- ENCABEZADO -->

            <Label
                Text="{Binding Titulo}"
                Style="{StaticResource HeaderLabel}"
                TextColor="#512478" />

            <Label
                Text="Completa la información del documento."
                Style="{StaticResource SubheaderLabel}" />

            <!-- FORMULARIO -->

            <Border
                Style="{StaticResource Card}"
                Stroke="#DDD3EF">

                <VerticalStackLayout Spacing="10">

                    <!-- TIPO DE DOCUMENTO -->

                    <Label
                        Text="Tipo de documento"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione el tipo de documento"
                        ItemsSource="{Binding TiposDocumento}"
                        SelectedItem="{Binding TipoDocumento, Mode=TwoWay}" />

                    <Label
                        Text="{Binding TipoDocumentoError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding TipoDocumentoError}"
                                Value="">
                                <Setter Property="IsVisible"
                                        Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- NUMERO DE DOCUMENTO -->

                    <Label
                        Text="Número de documento"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Entry
                        Placeholder="Ingrese el número del documento"
                        Text="{Binding NumeroDocumento, Mode=TwoWay}" />

                    <Label
                        Text="{Binding NumeroDocumentoError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding NumeroDocumentoError}"
                                Value="">
                                <Setter Property="IsVisible"
                                        Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- PAIS DE EMISION -->

                    <Label
                        Text="País de emisión"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione el país"
                        ItemsSource="{Binding PaisesEmision}"
                        SelectedItem="{Binding PaisEmision, Mode=TwoWay}" />

                    <Label
                        Text="{Binding PaisEmisionError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding PaisEmisionError}"
                                Value="">
                                <Setter Property="IsVisible"
                                        Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- FECHA DE EMISION -->

                    <Label
                        Text="Fecha de emisión"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <DatePicker
                        Format="dd/MM/yyyy"
                        Date="{Binding FechaEmision, Mode=TwoWay}" />

                    <Label
                        Text="{Binding FechaEmisionError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding FechaEmisionError}"
                                Value="">
                                <Setter Property="IsVisible"
                                        Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- FECHA DE VENCIMIENTO -->

                    <Label
                        Text="Fecha de vencimiento"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <DatePicker
                        Format="dd/MM/yyyy"
                        Date="{Binding FechaVencimiento, Mode=TwoWay}" />

                    <Label
                        Text="{Binding FechaVencimientoError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding FechaVencimientoError}"
                                Value="">
                                <Setter Property="IsVisible"
                                        Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- ESTADO -->

                    <Label
                        Text="Estado"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione el estado"
                        ItemsSource="{Binding EstadosDisponibles}"
                        SelectedItem="{Binding Estado, Mode=TwoWay}" />

                    <Label
                        Text="{Binding EstadoError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding EstadoError}"
                                Value="">
                                <Setter Property="IsVisible"
                                        Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                </VerticalStackLayout>

            </Border>

            <!-- GUARDAR -->

            <Button
                Text="GUARDAR"
                Style="{StaticResource PrimaryButton}"
                BackgroundColor="#673AB7"
                TextColor="White"
                Command="{Binding GuardarCommand}" />

            <!-- CANCELAR -->

            <Button
                Text="CANCELAR"
                Style="{StaticResource SecondaryButton}"
                BackgroundColor="#F0E9FC"
                TextColor="#512478"
                BorderColor="#8651D8"
                Command="{Binding CancelarCommand}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
