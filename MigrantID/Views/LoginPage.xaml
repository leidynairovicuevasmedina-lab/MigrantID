<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.LoginPage"
    Title="Iniciar sesión"
    BackgroundColor="#F4F7FA">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="18"
            VerticalOptions="Center">

            <!-- LOGOTIPO MIGRANTID -->

            <Image
                Source="migrantid_logo.png"
                HeightRequest="150"
                WidthRequest="230"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                Margin="0,10,0,0" />

            <!-- NOMBRE DE LA APLICACIÓN -->

            <Label
                Text="MigrantID RD"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#512478"
                HorizontalOptions="Center" />

            <Label
                Text="Verifica, Orienta y Protege tu información."
                FontSize="14"
                TextColor="#5F6B76"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,20" />

            <!-- TARJETA DE INICIO DE SESIÓN -->

            <Border
                BackgroundColor="White"
                Stroke="#DDD3EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Bienvenido"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#512478" />

                    <Label
                        Text="Ingresa tus datos para acceder al sistema"
                        FontSize="14"
                        TextColor="#687783" />

                    <!-- CORREO ELECTRÓNICO -->

                    <Entry
                        x:Name="CorreoEntry"
                        Placeholder="Correo electrónico"
                        Keyboard="Email"
                        HeightRequest="50" />

                    <!-- CONTRASEÑA -->

                    <Entry
                        x:Name="ContrasenaEntry"
                        Placeholder="Contraseña"
                        IsPassword="True"
                        HeightRequest="50" />

                    <!-- MENSAJE DE ERROR -->

                    <Label
                        x:Name="MensajeErrorLabel"
                        Text=""
                        FontSize="13"
                        TextColor="#B42318"
                        IsVisible="False" />

                    <!-- BOTÓN DE ACCESO -->

                    <Button
                        Text="INICIAR SESIÓN"
                        BackgroundColor="#673AB7"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="10"
                        Margin="0,10,0,0"
                        Clicked="OnLoginClicked" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
