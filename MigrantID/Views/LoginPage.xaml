<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MigrantID.Views.LoginPage"
             Title="Iniciar sesión"
             BackgroundColor="#F4F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                Text="MigrantID RD"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#123B5D"
                HorizontalOptions="Center" />

            <Label
                Text="Verifica, Orienta y Protege tu información."
                FontSize="14"
                TextColor="#5F6B76"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,20" />

            <Border
                BackgroundColor="White"
                Stroke="#D9E2EA"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Bienvenido"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#123B5D" />

                    <Label
                        Text="Ingresa tus datos para acceder al sistema"
                        FontSize="14"
                        TextColor="#687783" />

                    <Entry
                        Placeholder="Correo electrónico"
                        Keyboard="Email"
                        HeightRequest="50" />

                    <Entry
                        Placeholder="Contraseña"
                        IsPassword="True"
                        HeightRequest="50" />

                    <Button
                        Text="INICIAR SESIÓN"
                        BackgroundColor="#176B87"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="10"
                        Margin="0,10,0,0" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Trabajo de Rachelly Matias - Leidy Cuevas • Equipo #6"
                FontSize="12"
                TextColor="#89949E"
                HorizontalOptions="Center"
                Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>