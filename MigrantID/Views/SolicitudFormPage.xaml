<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.SolicitudFormPage"
    Title="Registrar solicitud">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Registrar solicitud de orientación"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label Text="Usuario" />

            <Picker
                x:Name="UsuarioPicker"
                Title="Seleccione un usuario"
                ItemDisplayBinding="{Binding Nombre}" />

            <Label Text="Tema de la solicitud" />

            <Picker
                x:Name="TemaPicker"
                Title="Seleccione un tema">

                <Picker.Items>
                    <x:String>Información migratoria</x:String>
                    <x:String>Consulta de documentos</x:String>
                    <x:String>Estado de solicitud</x:String>
                    <x:String>Otra orientación</x:String>
                </Picker.Items>

            </Picker>

            <Label Text="Descripción" />

            <Editor
                x:Name="DescripcionEditor"
                Placeholder="Escriba el motivo de la solicitud"
                HeightRequest="120" />

            <Label
                x:Name="MensajeErrorLabel"
                TextColor="Red"
                IsVisible="False" />

            <Button
                Text="Guardar"
                Clicked="OnGuardarClicked" />

            <Button
                Text="Cancelar"
                Clicked="OnCancelarClicked"
                BackgroundColor="Gray"
                TextColor="White" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
