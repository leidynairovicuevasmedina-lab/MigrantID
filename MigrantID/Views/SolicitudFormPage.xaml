<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.SolicitudFormPage"
    Title="Registrar solicitud"
    BackgroundColor="#F7F4FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,20,20,28"
            Spacing="14">

            <!-- ENCABEZADO -->

            <Label
                Text="Registrar solicitud de orientación"
                Style="{StaticResource HeaderLabel}"
                TextColor="#512478" />

            <Label
                Text="Completa los datos de la solicitud."
                Style="{StaticResource SubheaderLabel}" />

            <!-- FORMULARIO -->

            <Border
                Style="{StaticResource Card}"
                Stroke="#DDD3EF">

                <VerticalStackLayout Spacing="10">

                    <!-- USUARIO -->

                    <Label
                        Text="Usuario"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione un usuario"
                        ItemsSource="{Binding UsuariosDisponibles}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding UsuarioSeleccionado, Mode=TwoWay}" />

                    <Label
                        Text="{Binding UsuarioError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding UsuarioError}"
                                Value="">
                                <Setter
                                    Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- TEMA DE LA SOLICITUD -->

                    <Label
                        Text="Tema de la solicitud"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione un tema"
                        ItemsSource="{Binding TemasDisponibles}"
                        SelectedItem="{Binding TemaSeleccionado, Mode=TwoWay}" />

                    <Label
                        Text="{Binding TemaError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding TemaError}"
                                Value="">
                                <Setter
                                    Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- DESCRIPCION -->

                    <Label
                        Text="Descripción"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Editor
                        Placeholder="Escriba el motivo de la solicitud"
                        HeightRequest="120"
                        AutoSize="Disabled"
                        Text="{Binding Descripcion, Mode=TwoWay}" />

                    <Label
                        Text="{Binding DescripcionError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding DescripcionError}"
                                Value="">
                                <Setter
                                    Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                </VerticalStackLayout>

            </Border>

            <!-- BOTON GUARDAR -->

            <Button
                Text="GUARDAR SOLICITUD"
                Style="{StaticResource PrimaryButton}"
                BackgroundColor="#673AB7"
                TextColor="White"
                Command="{Binding GuardarCommand}" />

            <!-- BOTON CANCELAR -->

            <Button
                Text="CANCELAR"
                Style="{StaticResource SecondaryButton}"
                BackgroundColor="#F0E9FC"
                TextColor="#512478"
                BorderColor="#8651D8"
                Command="{Binding CancelarCommand}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
