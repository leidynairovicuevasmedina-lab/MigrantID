<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MigrantID.ViewModels"
    x:Class="MigrantID.Views.UsuarioFormPage"
    x:DataType="vm:UsuarioFormViewModel"
    Title="Registrar usuario"
    BackgroundColor="#F7F4FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,20,20,28"
            Spacing="14">

            <!-- ENCABEZADO -->

            <Label
                Text="Registrar usuario"
                Style="{StaticResource HeaderLabel}"
                TextColor="#512478" />

            <Label
                Text="Completa la información del usuario."
                Style="{StaticResource SubheaderLabel}" />

            <!-- FORMULARIO -->

            <Border
                Style="{StaticResource Card}"
                Stroke="#DDD3EF">

                <VerticalStackLayout Spacing="10">

                    <!-- NOMBRE COMPLETO -->

                    <Label
                        Text="Nombre completo"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Entry
                        Placeholder="Ingrese el nombre completo"
                        Keyboard="Text"
                        Text="{Binding Nombre, Mode=TwoWay}" />

                    <Label
                        Text="{Binding NombreError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding NombreError}"
                                Value="">
                                <Setter
                                    Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- CORREO ELECTRONICO -->

                    <Label
                        Text="Correo electrónico"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Entry
                        Placeholder="ejemplo@correo.com"
                        Keyboard="Email"
                        Text="{Binding Correo, Mode=TwoWay}" />

                    <Label
                        Text="{Binding CorreoError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding CorreoError}"
                                Value="">
                                <Setter
                                    Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    <!-- ROL DEL USUARIO -->

                    <Label
                        Text="Rol"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione un rol"
                        ItemsSource="{Binding RolesDisponibles}"
                        SelectedItem="{Binding RolSeleccionado, Mode=TwoWay}" />

                    <Label
                        Text="{Binding RolError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding RolError}"
                                Value="">
                                <Setter
                                    Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                </VerticalStackLayout>

            </Border>

            <!-- BOTON GUARDAR -->

            <Button
                Text="GUARDAR USUARIO"
                Style="{StaticResource PrimaryButton}"
                BackgroundColor="#673AB7"
                TextColor="White"
                Command="{Binding GuardarCommand}" />

            <!-- BOTON CANCELAR -->

            <Button
                Text="CANCELAR"
                Style="{StaticResource SecondaryButton}"
                BackgroundColor="#F0E9FC"
                TextColor="#512478"
                BorderColor="#8651D8"
                Command="{Binding CancelarCommand}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
