<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.VerificacionFormPage"
    Title="Registrar verificación"
    BackgroundColor="#F7F4FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,20,20,28"
            Spacing="14">

            
            <Label
                Text="Registrar verificación"
                Style="{StaticResource HeaderLabel}"
                TextColor="#512478" />

            <Label
                Text="Completa los datos de la verificación."
                Style="{StaticResource SubheaderLabel}" />

         
            <Border                Style="{StaticResource Card}"
                Stroke="#DDD3EF">

                <VerticalStackLayout Spacing="10">

                    

                    <Label
                        Text="Documento a verificar"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione un documento"
                        ItemsSource="{Binding DocumentosDisponibles}"
                        ItemDisplayBinding="{Binding NumeroDocumento}"
                        SelectedItem="{Binding DocumentoSeleccionado, Mode=TwoWay}" />

                    <Label
                        Text="{Binding DocumentoError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding DocumentoError}"
                                Value="">

                                <Setter
                                    Property="IsVisible"
                                    Value="False" />

                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    
                    <Label
                        Text="Fecha de verificación"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <DatePicker
                        Format="dd/MM/yyyy"
                        Date="{Binding FechaVerificacion, Mode=TwoWay}" />

                    <Label
                        Text="{Binding FechaVerificacionError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding FechaVerificacionError}"
                                Value="">

                                <Setter
                                    Property="IsVisible"
                                    Value="False" />

                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                   

                    <Label
                        Text="Resultado"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Picker
                        Title="Seleccione un resultado"
                        ItemsSource="{Binding ResultadosDisponibles}"
                        SelectedItem="{Binding ResultadoSeleccionado, Mode=TwoWay}" />

                    <Label
                        Text="{Binding ResultadoError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding ResultadoError}"
                                Value="">

                                <Setter
                                    Property="IsVisible"
                                    Value="False" />

                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                    
                    <Label
                        Text="Observación"
                        Style="{StaticResource FormLabel}"
                        TextColor="#512478" />

                    <Editor
                        Placeholder="Escriba una observación"
                        HeightRequest="110"
                        AutoSize="Disabled"
                        Text="{Binding Observacion, Mode=TwoWay}" />

                    <Label
                        Text="{Binding ObservacionError}"
                        Style="{StaticResource ErrorLabel}"
                        TextColor="#D40000"
                        FontAttributes="Bold"
                        IsVisible="True">

                        <Label.Triggers>
                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding ObservacionError}"
                                Value="">

                                <Setter
                                    Property="IsVisible"
                                    Value="False" />

                            </DataTrigger>
                        </Label.Triggers>

                    </Label>

                </VerticalStackLayout>

            </Border>

         
            <Button
                Text="GUARDAR VERIFICACIÓN"
                Style="{StaticResource PrimaryButton}"
                BackgroundColor="#673AB7"
                TextColor="White"
                Command="{Binding GuardarCommand}" />

       
            <Button
                Text="CANCELAR"
                Style="{StaticResource SecondaryButton}"
                BackgroundColor="#F0E9FC"
                TextColor="#512478"
                BorderColor="#8651D8"
                Command="{Binding CancelarCommand}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
