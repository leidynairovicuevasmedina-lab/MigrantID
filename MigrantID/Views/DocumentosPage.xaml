<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.DocumentosPage"
    Title="Mis documentos"
    BackgroundColor="#F4F7FA">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="15">

      
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="6">

            <Label
                Text="Mis documentos"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#123B5D" />

            <Label
                Text="Consulta y administra los documentos registrados."
                FontSize="14"
                TextColor="#687783" />

        </VerticalStackLayout>

        
        <Label
            x:Name="MensajeVacioLabel"
            Grid.Row="1"
            Text="Todavía no hay documentos registrados."
            TextColor="#687783"
            IsVisible="False" />

        
        <CollectionView
            x:Name="DocumentosCollection"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDE5EB"
                        StrokeThickness="1"
                        Padding="15"
                        Margin="0,0,0,12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding TipoDocumento}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#123B5D" />

                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Número: " />
                                        <Span Text="{Binding NumeroDocumento}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="País: " />
                                        <Span Text="{Binding PaisEmision}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Vencimiento: " />
                                        <Span Text="{Binding FechaVencimiento, StringFormat='{0:dd/MM/yyyy}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Estado: " />
                                        <Span Text="{Binding Estado}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                        
                   <Grid
                   ColumnDefinitions="*,*"
                   ColumnSpacing="10">

                                <Button
                                    Grid.Column="0"
                                    Text="EDITAR"
                                    BackgroundColor="#176B87"
                                    TextColor="White"
                                    CornerRadius="10"
                                    Clicked="OnEditarClicked"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Grid.Column="1"
                                    Text="ELIMINAR"
                                    BackgroundColor="#F1F4F6"
                                    TextColor="#B42318"
                                    CornerRadius="10"
                                    Clicked="OnEliminarClicked"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        
        <Button
            Grid.Row="3"
            Text="+ AGREGAR DOCUMENTO"
            BackgroundColor="#176B87"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="12"
            HeightRequest="52"
            Clicked="OnAgregarClicked" />

    </Grid>

</ContentPage>
