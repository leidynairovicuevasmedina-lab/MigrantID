<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MigrantID.Views.VerificacionesPage"
    Title="Verificaciones">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Verificaciones registradas"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Button
            Text="Agregar verificación"
            Clicked="OnAgregarClicked" />

        <Label
            x:Name="MensajeVacioLabel"
            Text="No hay verificaciones registradas."
            HorizontalOptions="Center"
            IsVisible="False" />

        <CollectionView
            x:Name="VerificacionesCollection"
            VerticalOptions="Fill">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="LightGray"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding IdDocumento,
                                    StringFormat='Documento: {0}'}"
                                FontAttributes="Bold"
                                FontSize="18" />

                            <Label
                                Text="{Binding FechaVerificacion,
                                    StringFormat='Fecha: {0:dd/MM/yyyy}'}" />

                            <Label
                                Text="{Binding Resultado,
                                    StringFormat='Resultado: {0}'}" />

                            <Label
                                Text="{Binding Observacion,
                                    StringFormat='Observación: {0}'}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
