<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MigrantID.Models"
    x:Class="MigrantID.Views.VerificacionesPage"
    Title="Verificaciones"
    BackgroundColor="#F4F7FA">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="14">

      
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="Verificaciones registradas"
                Style="{StaticResource ListTitle}" />

            <Label
                Text="Consulta, edita o elimina verificaciones."
                Style="{StaticResource SubheaderLabel}" />

        </VerticalStackLayout>

       
        <CollectionView
            x:Name="VerificacionesCollection"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20,45"
                    Spacing="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="No hay verificaciones registradas"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="Red"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Agrega una verificación para comenzar."
                        Style="{StaticResource EmptyState}" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Verificacion">

                    <Border
                        Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,12">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                Text="Documento verificado"
                                FontSize="12"
                                TextColor="#66788A" />

                            <Label
                                Text="{Binding IdDocumento, StringFormat='ID del documento: {0}'}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#173B57" />

                            <Label
                                Text="Fecha de verificación"
                                FontSize="12"
                                TextColor="#66788A" />

                            <Label
                                Text="{Binding FechaVerificacion, StringFormat='{0:dd/MM/yyyy}'}"
                                FontSize="14"
                                TextColor="#26465F" />

                            <Label
                                Text="Resultado"
                                FontSize="12"
                                TextColor="#66788A" />

                            <Label
                                Text="{Binding Resultado}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#176B87" />

                            <Label
                                Text="Observación"
                                FontSize="12"
                                TextColor="#66788A" />

                            <Label
                                Text="{Binding Observacion}"
                                FontSize="14"
                                TextColor="#26465F"
                                LineBreakMode="WordWrap" />

                            
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10"
                                Margin="0,8,0,0">

                                <Button
                                    Grid.Column="0"
                                    Text="EDITAR"
                                    BackgroundColor="#673AB7"
                                    TextColor="White"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnEditarClicked" />

                                <Button
                                    Grid.Column="1"
                                    Text="ELIMINAR"
                                    BackgroundColor="#B42318"
                                    TextColor="White"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnEliminarClicked" />

                            </Grid>

                  </VerticalStackLayout>

            </Border>

           </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

      

        <Button
            Grid.Row="2"
            Text="+ AGREGAR VERIFICACIÓN"
            Style="{StaticResource PrimaryButton}"
            Clicked="OnAgregarClicked" />

    </Grid>

</ContentPage>
