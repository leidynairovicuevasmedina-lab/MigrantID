<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<!-- Plataforma Android, igual que el proyecto del profesor -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MigrantID</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Generacion de XAML -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Nombre de la aplicacion -->
		<ApplicationTitle>MigrantID</ApplicationTitle>

		<!-- Identificador de la aplicacion -->
		<ApplicationId>com.companyname.migrantid</ApplicationId>

		<!-- Versiones -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- Version minima de Android -->
		<SupportedOSPlatformVersion
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

	</PropertyGroup>

	<ItemGroup>

		<!-- Icono de la aplicacion -->
		<MauiIcon
            Include="Resources\AppIcon\appicon.svg"
            ForegroundFile="Resources\AppIcon\appiconfg.svg"
            Color="#512BD4" />

		<!-- Pantalla de inicio -->
		<MauiSplashScreen
            Include="Resources\Splash\splash.svg"
            Color="#512BD4"
            BaseSize="128,128" />

		<!-- Imagenes -->
		<MauiImage Include="Resources\Images\*" />

		<MauiImage
            Update="Resources\Images\dotnet_bot.png"
            Resize="True"
            BaseSize="300,185" />

		<!-- Fuentes -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Recursos adicionales -->
		<MauiAsset
            Include="Resources\Raw\**"
            LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

	</ItemGroup>

	<ItemGroup>

		<!-- CommunityToolkit MVVM -->
		<PackageReference
            Include="CommunityToolkit.Mvvm"
            Version="8.4.2" />

		<!-- Controles MAUI -->
		<PackageReference
            Include="Microsoft.Maui.Controls"
            Version="$(MauiVersion)" />

		<!-- Registro de depuracion -->
		<PackageReference
            Include="Microsoft.Extensions.Logging.Debug"
            Version="10.0.0" />

	</ItemGroup>

	<ItemGroup>

		<Compile Update="Views\SolicitudesPage.xaml.cs">
			<DependentUpon>SolicitudesPage.xaml</DependentUpon>
		</Compile>

		<Compile Update="Views\UsuarioFormPage.xaml.cs">
			<DependentUpon>UsuarioFormPage.xaml</DependentUpon>
		</Compile>

	</ItemGroup>

	<ItemGroup>

		<MauiXaml Update="Views\DocumentoFormPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\DocumentosPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\LoginPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\SolicitudesPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\PrincipalPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\SolicitudFormPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\UsuarioFormPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\UsuariosPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\VerificacionesPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\VerificacionFormPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

	</ItemGroup>

</Project>
