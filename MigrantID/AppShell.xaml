<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MigrantID.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MigrantID.Views"
    Title="MigrantID RD"
    FlyoutBehavior="Flyout">

    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="login" />

    <ShellContent Title="Inicio"
                  ContentTemplate="{DataTemplate views:PrincipalPage}"
                  Route="principal" />

    <ShellContent Title="Documentos"
                  ContentTemplate="{DataTemplate views:DocumentosPage}"
                  Route="documentos" />

    <ShellContent Title="Formulario"
                  ContentTemplate="{DataTemplate views:DocumentoFormPage}"
                  Route="documento-form" />

</Shell>